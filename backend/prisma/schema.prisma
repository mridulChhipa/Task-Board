// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  USER
  GLOBAL_ADMIN
}

enum ProjectLevelRole {
  PROJECT_ADMIN
  PROJECT_MEMBER
  PROJECT_VIEWER
}

model User {
  id                    Int                @id @default(autoincrement())
  name                  String
  password              String
  email                 String             @unique
  avatar                String?
  globalRole            GlobalRole         @default(USER)
  comments              Comment[]
  threads               Thread[]
  sessions              Session[]
  projects              ProjectMember[]
  notifications         UserNotification[]
  commentActivities     Activity[]         @relation("commentUser")
  oldAssigneeActivities Activity[]         @relation("oldAssignee")
  newAssigneeActivities Activity[]         @relation("newAssignee")
}

model Session {
  id        String   @id @default(uuid())
  userId    Int
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id           String   @id @default(uuid())
  name         String
  description  String?
  createdAt    DateTime @default(now())
  lastModified DateTime @updatedAt
  isArchived   Boolean  @default(false)

  members ProjectMember[]
  boards  Board[]
}

model ProjectMember {
  id        String           @id @default(uuid())
  projectId String
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectLevelRole

  @@unique([projectId, userId], name: "uniqueUser")
}

model Board {
  id              String           @id @default(uuid())
  name            String
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflows       Workflow[]
  edgeConstraints EdgeConstraint[]
}

model Workflow {
  id       String @id @default(uuid())
  name     String
  orderIdx Int
  boardId  String
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  limit    Int    @default(5)

  tasks            Task[]
  activitiesOld    Activity[]       @relation("oldStatus")
  activitiesNew    Activity[]       @relation("newStatus")
  startConstraints EdgeConstraint[] @relation("startedge")
  endConstraints   EdgeConstraint[] @relation("endedge")
}

enum TaskType {
  STORY
  TASK
  BUG
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  type        TaskType   @default(TASK)
  priority    Priority   @default(MEDIUM)
  assignee    Int
  reporter    Int
  dueDate     DateTime?
  statusId    String
  status      Workflow   @relation(fields: [statusId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  resolvedAt  DateTime?
  closedAt    DateTime?
  parentId    String?
  parent      Task?      @relation("TaskToTask", fields: [parentId], references: [id], onDelete: Cascade)
  children    Task[]     @relation("TaskToTask")
  threads     Thread[]
  activities  Activity[]
}

enum ActivityType {
  TASK_STATUS_UPDATED
  TASK_ASSIGNEE_CHANGED
  COMMENT_ADDED
  COMMENT_EDITED
  COMMENT_DELETED
  THREAD_ADDED
  THREAD_EDITED
  THREAD_DELETED
}

model Activity {
  id             String       @id @default(uuid())
  type           ActivityType
  taskId         String?
  task           Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  threadId       String?
  thread         Thread?      @relation(fields: [threadId], references: [id], onDelete: SetNull)
  commentId      String?
  comment        Comment?     @relation(fields: [commentId], references: [id], onDelete: SetNull)
  oldStatusId    String?
  oldStatus      Workflow?    @relation(name: "oldStatus", fields: [oldStatusId], references: [id], onDelete: SetNull)
  newStatusId    String?
  newStatus      Workflow?    @relation(name: "newStatus", fields: [newStatusId], references: [id], onDelete: SetNull)
  oldAssigneeId  Int?
  oldAssignee    User?        @relation(name: "oldAssignee", fields: [oldAssigneeId], references: [id], onDelete: SetNull)
  newAssigneeId  Int?
  newAssignee    User?        @relation(name: "newAssignee", fields: [newAssigneeId], references: [id], onDelete: SetNull)
  threadAdded    Boolean      @default(false)
  commentAdded   Boolean      @default(false)
  editedThread   Boolean      @default(false)
  deletedThread  Boolean      @default(false)
  editedComment  Boolean      @default(false)
  deletedComment Boolean      @default(false)
  assignedTask   Boolean      @default(false)
  updatedStatus  Boolean      @default(false)
  timestamp      DateTime     @default(now())
  user           User?        @relation(name: "commentUser", fields: [userId], references: [id], onDelete: SetNull)
  userId         Int?
}

model Thread {
  id         String     @id @default(uuid())
  title      String
  content    String?
  comments   Comment[]
  authorId   Int
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isDeleted  Boolean    @default(false)
  taskId     String
  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  activities Activity[]
}

model Comment {
  id         String     @id @default(uuid())
  content    String
  threadId   String?
  thread     Thread?    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId   Int
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isDeleted  Boolean    @default(false)
  parentId   String?
  parent     Comment?   @relation("C2R", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[]  @relation("C2R")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  activities Activity[]
}

model Notification {
  id         String             @id @default(uuid())
  type       NotifType
  read       Boolean            @default(false)
  recipients UserNotification[]
  senderId   Int
  taskId     String?
  commentId  String?
  threadId   String?
}

enum NotifType {
  TASK_ASSIGNED // Personal
  STATUS_CHANGED // Broadcast
  COMMENT_ADDED // Boardcast
  MENTIONED // Personal
  REPLY // Personal
  THREAD_STARTED
}

model UserNotification {
  id             String       @id @default(cuid())
  userId         Int
  notificationId String
  timestamp      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([userId])
  @@index([notificationId])
}

model EdgeConstraint {
  id      String   @id @default(uuid())
  boardId String
  board   Board    @relation(fields: [boardId], references: [id])
  uId     String
  u       Workflow @relation(name: "startedge", fields: [uId], references: [id])
  vId     String
  v       Workflow @relation(name: "endedge", fields: [vId], references: [id])
}
