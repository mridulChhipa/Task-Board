// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  USER
  GLOBAL_ADMIN
}

enum ProjectLevelRole {
  PROJECT_ADMIN
  PROJECT_MEMBER
  PROJECT_VIEWER
}

model User {
  id         Int        @id @default(autoincrement())
  name       String
  password   String
  email      String     @unique
  avatar     String?
  globalRole GlobalRole @default(USER)

  comments Comment[]
  threads  Thread[]
  sessions Session[]
  projects ProjectMember[]
}

model Session {
  id        String   @id @default(uuid())
  userId    Int
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id           String   @id @default(uuid())
  name         String
  description  String?
  createdAt    DateTime @default(now())
  lastModified DateTime @updatedAt
  isArchived   Boolean  @default(false)

  members ProjectMember[]
  boards  Board[]
}

model ProjectMember {
  id        String           @id @default(uuid())
  projectId String
  project   Project          @relation(fields: [projectId], references: [id])
  userId    Int
  user      User             @relation(fields: [userId], references: [id])
  role      ProjectLevelRole

  @@unique([projectId, userId], name: "uniqueUser")
}

model Board {
  id        String     @id @default(uuid())
  name      String
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflows Workflow[]
}

model Workflow {
  id       String @id @default(uuid())
  name     String
  orderIdx Int
  boardId  String
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  limit    Int    @default(5)

  tasks Task[]
}

enum TaskType {
  STORY
  TASK
  BUG
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Task {
  id            String    @id @default(uuid())
  title         String
  description   String?
  type          TaskType  @default(TASK)
  priority      Priority  @default(MEDIUM)
  assignee      Int
  reporter      Int
  stackPosition Int
  dueDate       DateTime?
  statusId      String
  status        Workflow  @relation(fields: [statusId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  resolvedAt    DateTime?
  closedAt      DateTime?
  parentId      String?
  parent        Task?     @relation("TaskToTask", fields: [parentId], references: [id], onDelete: Cascade)
  children      Task[]    @relation("TaskToTask")
  threads       Thread[]
}

enum ActivityType {
  TASK_STATUS_UPDATED
  TASK_ASSIGNEE_CHANGED
  COMMENT_ADDED
  COMMENT_EDITED
  COMMENT_DELETED
  THREAD_ADDED
  THREAD_EDITED
  THREAD_DELETED
}

model Activity {
  id             String       @id @default(uuid())
  type           ActivityType
  taskId         String
  threadId       String?
  commentId      String?
  oldStatusId    String?
  newStatusId    String?
  oldAssignee    Int?
  newAssignee    Int?
  threadAdded    Boolean      @default(false)
  commentAdded   Boolean      @default(false)
  editedThread   Boolean      @default(false)
  deletedThread  Boolean      @default(false)
  editedComment  Boolean      @default(false)
  deletedComment Boolean      @default(false)
  assignedTask   Boolean      @default(false)
  updatedStatus  Boolean      @default(false)
  timestamp      DateTime     @default(now())
}

model Thread {
  id        String    @id @default(uuid())
  title     String
  content   String?
  comments  Comment[]
  authorId  Int
  author    User      @relation(fields: [authorId], references: [id])
  isDeleted Boolean   @default(false)
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Comment {
  id        String    @id @default(uuid())
  content   String
  threadId  String
  thread    Thread    @relation(fields: [threadId], references: [id])
  authorId  Int
  author    User      @relation(fields: [authorId], references: [id])
  isDeleted Boolean   @default(false)
  parentId  String?
  parent    Comment?  @relation("C2R", fields: [parentId], references: [id])
  replies   Comment[] @relation("C2R")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
